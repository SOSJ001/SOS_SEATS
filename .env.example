# Public (embedded in the browser build — use anon key only; never service role)
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Solana (public)
PUBLIC_SOLANA_NETWORK=devnet
PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Monime (SERVER ONLY — do not use PUBLIC_ prefix; rotate keys that were ever committed or exposed as PUBLIC_MONIME_*)
MONIME_API_KEY=
MONIME_PAYOUT_API_KEY=
MONIME_SPACE_ID=
# live | test (test enables mock/payment-status shortcuts where applicable)
MONIME_ENVIRONMENT=live

# Optional: JSON map of currency key -> { "minTicketPrice": number } (major units). Merged over defaults in src/lib/config/monimeLimits.ts
# MONIME_PRICING_LIMITS_JSON={"GBP":{"minTicketPrice":0.5}}

# Comma-separated Web3 wallet addresses allowed to open /dashboard/ops/pulse and see "SOS Pulse" in the sidebar
# OPS_ADMIN_WALLETS=3ZPcjHB48wwrHmpj1pMkH3ohbEaajpTVHZJuAw4TwVzL
# Optional legacy compatibility: comma-separated organizer user ids (session user_Id)
# OPS_ADMIN_USER_IDS=
