# Fee rates (percent points, e.g. 0.99 = 0.99%, 5 = 5%)
# Copy into .env; change once to update landing, checkout, wallet, and hub overview.

# Booking fee: paid by the buyer at checkout.
# PUBLIC_BOOKING_FEE_MODE=percent uses PUBLIC_BOOKING_FEE_PERCENT on the ticket total.
# PUBLIC_BOOKING_FEE_MODE=flat charges PUBLIC_BOOKING_FEE_FLAT NLe once per order.
PUBLIC_BOOKING_FEE_MODE=percent
PUBLIC_BOOKING_FEE_PERCENT=0.99
PUBLIC_BOOKING_FEE_FLAT=1

# Platform fee: taken from each ticket sale before it reaches the organiser's wallet.
PUBLIC_PLATFORM_FEE_PERCENT=5
# Mobile money transfer fee: taken from each withdrawal.
PUBLIC_WITHDRAWAL_MONIME_FEE_PERCENT=1

# Signs the userSession cookie (HMAC-SHA256). Required in production, at least 32 chars.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Monime (server-only). Never expose these as PUBLIC_* variables.
MONIME_API_KEY=
MONIME_SPACE_ID=
MONIME_ENVIRONMENT=live
# Optional payout-scoped key (falls back to MONIME_API_KEY)
MONIME_PAYOUT_API_KEY=
# Webhook HS256 secret (32–256 chars). Required for POST /api/monime/webhook (5.4).
MONIME_WEBHOOK_SECRET=
